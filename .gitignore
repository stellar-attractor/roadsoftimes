# macOS
.DS_Store
.AppleDouble
.LSOverride

# Скрины отладки (тяжёлые, не нужны в репо)
screens/

# Исходные фото (хранятся в Blogger CDN, не в репо)
images/
# Ресурсы (тяжёлые), кроме логотипа
assets/*
!assets/logo-200.png
!assets/favicon.ico
!assets/apple-touch-icon.png
!assets/og-cover.jpg

# Мокап (2.4MB, уже не нужен для разработки)
mockup.png

# Исходник GameTown (бинарные ресурсы)
GameTown Blogger Template/images/
GameTown Blogger Template/js/
GameTown Blogger Template/*.url
GameTown Blogger Template/wowslider.txt

# Claude
.claude/

# IDE / editor
.idea/

# Cloudflare local cache
.wrangler/

# macOS folder alias
Roads Of Times Site

# Производные / кэш
__pycache__/
*.pyc
*.pyo
/assets/
preview/

# media.roadsoftimes.com deploy source — local filesystem + wrangler direct
# upload only, never through GitHub/cdn.roadsoftimes.com.
site/media-site/

# assets.roadsoftimes.com deploy source — shared photo CDN for Places/Times/
# Roads (small tables, tens-hundreds of rows; kept separate from the exhibit
# media tree above). Same rule: local filesystem + wrangler direct upload
# only, never through GitHub/cdn.roadsoftimes.com. Museums stays on
# media-site/exhibits/ for now — not migrated here.
site/assets-site/

# No binary assets and no ad-hoc JSON backups belong in site/ — assets live
# under site/media-site/assets/, and museums.json/infographics.json are the
# only source of truth (no snapshot copies).
site/assets/
site/db_backups/
