# macOS
.DS_Store
.AppleDouble
.LSOverride

# Скрины отладки (тяжёлые, не нужны в репо)
screens/

# Исходные фото (хранятся в Blogger CDN, не в репо)
images/
# Ресурсы (тяжёлые), кроме логотипа
assets/*
!assets/logo-200.png
!assets/favicon.ico
!assets/apple-touch-icon.png
!assets/og-cover.jpg

# Мокап (2.4MB, уже не нужен для разработки)
mockup.png

# Исходник GameTown (бинарные ресурсы)
GameTown Blogger Template/images/
GameTown Blogger Template/js/
GameTown Blogger Template/*.url
GameTown Blogger Template/wowslider.txt

# Claude
.claude/

# IDE / editor
.idea/

# Cloudflare local cache
.wrangler/

# macOS folder alias
Roads Of Times Site

# Производные / кэш
__pycache__/
*.pyc
*.pyo
/assets/
preview/

# media.roadsoftimes.com deploy source — local filesystem + wrangler direct
# upload only, never through GitHub/cdn.roadsoftimes.com. Places/Times/Roads
# photos live under site/media-site/assets/{type}/{id}/ — same tree, same
# CDN as exhibits/museums; no separate assets CDN. museums/places/times/
# roads.json live under site/media-site/db/ (Epic #47) — deployed by
# wrangler, not committed, same as the binary assets in this tree.
# _headers is the one file in this tree that IS tracked (Cloudflare Pages
# config, not data) — the `*` + negation form is required for git to look
# inside an otherwise-ignored directory for it.
site/media-site/*
!site/media-site/_headers

# No binary assets and no ad-hoc JSON backups belong in site/ — assets live
# under site/media-site/assets/, and museums.json/infographics.json are the
# only source of truth (no snapshot copies).
site/assets/
site/db_backups/
